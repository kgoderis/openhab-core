Bundle-Name: openHAB Core :: Bundles :: AI :: Common (Consolidated)
Bundle-SymbolicName: org.openhab.core.ai.common
Bundle-Version: 1.0.0.${tstamp}
Bundle-Activator: org.openhab.core.ai.internal.AIBundleActivator
Bundle-Vendor: openHAB Community
Bundle-Description: Consolidated AI bundle providing MCP and A2A protocol support for openHAB
Bundle-DocURL: https://www.openhab.org
Bundle-License: https://www.eclipse.org/legal/epl-v2.html
Bundle-RequiredExecutionEnvironment: JavaSE-11

# Import packages
Import-Package: \\
    org.eclipse.jdt.annotation;version=\"[2.2,3)\", \\
    org.osgi.framework;version=\"[1.8,2)\", \\
    org.slf4j;version=\"[1.7,3)\", \\
    *

# Export packages
Export-Package: \
    org.openhab.core.ai.api.*;version="1.0.0", \
    org.openhab.core.ai.action.*;version="1.0.0", \
    org.openhab.core.ai.agent.*;version="1.0.0", \
    org.openhab.core.ai.auth.*;version="1.0.0", \
    org.openhab.core.ai.config.*;version="1.0.0", \
    org.openhab.core.ai.llm.*;version="1.0.0", \
    org.openhab.core.ai.tool.*;version="1.0.0", \
    org.openhab.core.ai.reasoning.*;version="1.0.0", \
    org.openhab.core.ai.util.*;version="1.0.0"

# Private packages (not exported)
Private-Package: \
    org.openhab.core.ai.internal.*, \
    org.openhab.core.ai.stub.*

# Manifest headers
Manifest-Version: 1.0
Created-By: openHAB AI Bundle Generator 