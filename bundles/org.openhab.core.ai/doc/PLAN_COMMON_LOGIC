```java
// Base exception class
public abstract class AIException extends Exception {
    private final String entityId;
    private final ErrorCode errorCode;
    private final long timestamp;
    
    protected AIException(String entityId, String message, ErrorCode errorCode, Throwable cause) {
        super(message, cause);
        this.entityId = entityId;
        this.errorCode = errorCode;
        this.timestamp = System.currentTimeMillis();
    }
}

// Error information
public class ErrorInfo {
    private final String errorType;
    private final String message;
    private final long count;
    private final long lastOccurrence;
    private final ErrorCode errorCode;
}

// Recovery strategy interface
public interface RecoveryStrategy<T> {
    boolean canRecover(ErrorInfo errorInfo);
    T recover(ErrorInfo errorInfo, @Nullable T context);
    long getRetryDelay();
    int getMaxRetries();
}

// Protocol-specific exceptions
public class ToolException extends AIException { /* Tool-specific exceptions */ }
public class AgentException extends AIException { /* Agent-specific exceptions */ }
```

