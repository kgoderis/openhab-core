<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.3.0" name="org.openhab.core.io.http.internal.OpenHABHttpContext">
  <property name="osgi.http.whiteboard.context.path" type="String" value="/"/>
  <property name="osgi.http.whiteboard.context.name" type="String" value="oh-dfl-http-ctx"/>
  <service>
    <provide interface="org.osgi.service.http.HttpContext"/>
    <provide interface="org.openhab.core.io.http.WrappingHttpContext"/>
  </service>
  <reference name="Handler" cardinality="0..n" policy="dynamic" interface="org.openhab.core.io.http.Handler" bind="addHandler" unbind="removeHandler"/>
  <implementation class="org.openhab.core.io.http.internal.OpenHABHttpContext"/>
</scr:component>
